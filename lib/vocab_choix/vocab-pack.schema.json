{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vocab-pack v1.0",
  "type": "object",
  "required": ["format", "version", "meta", "themes", "grammar"],
  "properties": {
    "format": { "const": "vocab-pack" },
    "version": { "const": "1.0" },
    "meta": {
      "type": "object",
      "required": ["id", "title", "source_lang", "target_lang"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source_lang": { "type": "string", "minLength": 1 },
        "target_lang": { "type": "string", "minLength": 1 },
        "course": { "type": "string" },
        "source_file": { "type": "string" },
        "created": { "type": "string" }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "entries"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer" },
          "color": { "type": "string" },
          "include": { "type": "array", "items": { "type": "string" } },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "term", "term_key", "translation"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "term": { "type": "string", "minLength": 1 },
                "term_key": { "type": "string", "minLength": 1 },
                "translation": { "type": "string", "minLength": 1 },
                "pos": { "type": "string" },
                "stress": { "type": "string" },
                "context": { "type": "string" },
                "highlight": { "type": "string" },
                "sense": { "type": "string" },
                "note": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "read_aloud": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["written", "fr", "en"],
              "properties": {
                "written": { "type": "string", "minLength": 1 },
                "fr": { "type": "string", "minLength": 1 },
                "en": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "rule", "examples", "mistakes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "theme": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "structure": { "type": "string" },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["en", "fr"],
              "properties": {
                "en": { "type": "string", "minLength": 1 },
                "fr": { "type": "string", "minLength": 1 }
              }
            }
          },
          "mistakes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["wrong", "right", "explanation"],
              "properties": {
                "wrong": { "type": "string", "minLength": 1 },
                "right": { "type": "string", "minLength": 1 },
                "explanation": { "type": "string", "minLength": 1 }
              }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
